APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Production (TiDB Cloud): set DB_CONNECTION=mysql, DB_PORT=4000 (not 3306),
# plus the vars above from your TiDB Cloud connection panel. TiDB Cloud's cert
# usually chains to a public CA already trusted by the system bundle, so
# MYSQL_ATTR_SSL_CA can normally stay unset — only needed if PDO fails the SSL
# handshake:
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Module 7 — Backup & Restore: đường dẫn binary mysqldump. Bỏ qua nếu mysqldump
# đã có trong PATH hệ thống. Trên Windows dùng XAMPP, ví dụ (dùng dấu / để tránh
# dotenv hiểu nhầm \x thành escape sequence):
# MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
# MYSQLDUMP_PATH=mysqldump

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Book covers / avatars disk — keep "public" for local dev. On DO App Platform
# (ephemeral containers, no persistent disk) set MEDIA_DISK=s3 and fill in the
# AWS_* Spaces vars below.
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_ADDRESS=your_gmail@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# --- DigitalOcean Spaces (only needed when MEDIA_DISK=s3) ---
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY = a Spaces API key pair (generate at
#   cloud.digitalocean.com/account/api/spaces), NOT your DO account API token.
# AWS_DEFAULT_REGION=sgp1                                  # your Space's region slug
# AWS_BUCKET=library-uploads                                # your Space's name
# AWS_ENDPOINT=https://sgp1.digitaloceanspaces.com          # region endpoint (no bucket in host)
# AWS_URL=https://library-uploads.sgp1.digitaloceanspaces.com  # public base URL used to build cover/avatar links
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Comma-separated list of allowed frontend origins (Vercel domains). Falls back
# to '*' only when unset — always set this in production.
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://www.example.com

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
AI_MOCK_MODE=false
